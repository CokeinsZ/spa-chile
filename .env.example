# PostgreSQL — cadena de conexión
# Supabase: usa la cadena del "Session pooler" (IPv4) y agrega ?sslmode=require
DATABASE_URL=postgresql://usuario:password@localhost:5432/servicio_americano

# Opcional pero recomendado: ruta al certificado CA del proveedor para
# verificar el servidor además de cifrar. Supabase: Dashboard → Project
# Settings → Database → SSL → "Download CA certificate".
# DATABASE_CA_CERT=certs/supabase-ca.crt

# Cuenta de servicio
GOOGLE_CALENDAR_ID=xxxxxxxxxx@group.calendar.google.com
GOOGLE_CLIENT_EMAIL=calendar-bot@tu-proyecto.iam.gserviceaccount.com
# Clave privada completa en una sola línea, con \n donde van los saltos:
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Cloudflare Turnstile (anti-bots del formulario de citas)
# Dashboard de Cloudflare → Turnstile → widget del sitio.
# Los valores de abajo son las claves de PRUEBA oficiales de Cloudflare
# (siempre aprueban, funcionan en localhost); en producción usa las reales.
# La site key se incrusta al compilar (en Docker llega como build arg).
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
