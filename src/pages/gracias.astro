---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/atoms/Container.astro';
import Button from '../components/atoms/Button.astro';
import GoogleAds from '../components/atoms/GoogleAds.astro';
import { site, whatsappDefaultLink } from '../data/site';
---

<BaseLayout title={`¡Cita agendada! — ${site.name}`}>
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
    <GoogleAds bookingConversion />
  </Fragment>

  <main class="flex min-h-screen items-center bg-navy py-[84px] text-white max-sm:py-14">
    <Container class="flex flex-col items-center text-center">
      <a href="/" aria-label={`Inicio — ${site.name}`}>
        <img src="/logo.webp" alt={site.name} width="760" height="400" class="h-20 w-auto rounded-md" />
      </a>
      <h1 class="mt-8 font-display text-[clamp(26px,3.6vw,38px)] font-bold">¡Cita agendada!</h1>
      <p id="booking-detail" class="mt-3.5 max-w-[520px] text-[15.5px] leading-[1.7] text-[#c6d3d2]">
        Registramos tu solicitud de visita técnica y te confirmaremos a la brevedad. Si necesitas
        modificar la hora, escríbenos por WhatsApp.
      </p>
      <div class="mt-[26px] flex flex-wrap justify-center gap-3">
        <Button href="/" variant="primary">Volver al inicio</Button>
        <Button href={whatsappDefaultLink} variant="outline" target="_blank" rel="noopener">
          Escribir por WhatsApp
        </Button>
      </div>
    </Container>
  </main>
</BaseLayout>

<script>
  import { CONFIRMATION_STORAGE_KEY, type BookingConfirmation } from '../lib/confirmation';

  // Detalle de la cita que dejó el formulario antes de redirigir. Se borra al
  // leerlo para no dejar el teléfono guardado; GoogleAds ya lo leyó en el <head>
  // (los scripts de módulo corren después) y al recargar no se repite la conversión.
  try {
    const stored = sessionStorage.getItem(CONFIRMATION_STORAGE_KEY);
    sessionStorage.removeItem(CONFIRMATION_STORAGE_KEY);
    const detail = document.getElementById('booking-detail');
    if (stored && detail) {
      const { at, phone } = JSON.parse(stored) as BookingConfirmation;
      const when = new Intl.DateTimeFormat('es-CL', {
        dateStyle: 'full',
        timeStyle: 'short',
        timeZone: 'America/Santiago',
      }).format(new Date(at));
      detail.textContent = `Registramos tu visita para el ${when} — te confirmaremos al +56 9 ${phone}. Si necesitas modificar la hora, escríbenos por WhatsApp.`;
    }
  } catch {
    // Sin datos guardados se mantiene el mensaje genérico
  }
</script>
