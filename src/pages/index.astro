import Hero from '../components/organisms/Hero.astro';
import TrustStrip from '../components/organisms/TrustStrip.astro';
import ServicesPanel from '../components/organisms/ServicesPanel.astro';
import ProcessSteps from '../components/organisms/ProcessSteps.astro';
