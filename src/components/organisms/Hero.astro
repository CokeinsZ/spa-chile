---
import Button from '../atoms/Button.astro';
import Container from '../atoms/Container.astro';
import Logo from '../atoms/Logo.astro';
import HeroStat from '../molecules/HeroStat.astro';
import ServiceStatusRow from '../molecules/ServiceStatusRow.astro';
import { site } from '../../data/site';

const stats = [
  { value: '40+', label: 'Años en el oficio' },
  { value: '24h', label: 'Respuesta promedio' },
  { value: '100%', label: 'Marcas atendidas' },
];

const statusLines = [
  'Refrigeración domestica y comercial — todas las marcas',
  'Aire acondicionado',
  'Cámaras de frío',
  'Lavadoras y secadoras',
];
---

<div id="hero-scroll" class="relative h-[260vh] supports-[height:100svh]:h-[260svh]">
  <div
    id="hero-sticky"
    class="sticky top-[77px] h-[calc(100vh-77px)] overflow-hidden sm:top-[93px] sm:h-[calc(100vh-93px)] supports-[height:100svh]:h-[calc(100svh-77px)] supports-[height:100svh]:sm:h-[calc(100svh-93px)]"
  >
    {/* ── CAPA 1: Primera vista (v3 apaisada, texto sobre el fondo vacío derecho) ── */}
    <div id="first-view" class="absolute inset-0 z-[2] bg-[#c3dcea] will-change-[opacity,transform]">
      {/* Fondo fotográfico a pantalla completa de la capa */}
      <img
        id="intro-bg"
        src="/primera_vista_v3.jpg"
        alt="Técnico especializado junto a un refrigerador americano"
        class="absolute inset-0 h-full w-full object-cover object-[16%_top] will-change-[opacity,transform] max-[900px]:hidden"
        fetchpriority="high"
      />

      <div class="relative flex h-full flex-col max-[900px]:overflow-y-auto">
        {/* En móvil la foto va arriba como franja (y se usa la v1) */}
        <img
          src="/primera_vista.jpg"
          alt=""
          aria-hidden="true"
          class="hidden w-full shrink-0 object-cover object-[10%_15%] max-[900px]:block max-[900px]:h-[32vh]"
        />

        <Container
          class="grid flex-1 grid-cols-2 items-center gap-10 py-8 max-[900px]:grid-cols-1 max-[900px]:gap-5 max-[900px]:py-6"
        >
          {/* Mitad izquierda: vacía en desktop para dejar ver técnico + refrigerador */}
          <div class="max-[900px:hidden]" aria-hidden="true"></div>

          <div id="intro-text" class="text-navy will-change-[opacity,transform] md:mt-12 md:pl-6 lg:mt-16 lg:pl-10">
            <h1
              class="max-w-[560px] font-display text-[clamp(30px,4.6vw,56px)] leading-[1.08] font-bold text-balance"
            >
              Tu primera y mejor opción en Chile para marcas americanas
              <span class="text-teal-deep"> — y mucho más.</span>
            </h1>
            <p class="mt-5 max-w-[480px] text-base leading-[1.7] text-navy/80">
              Especialistas en Sub-Zero, Viking, Thermador, GE y todas las marcas
              americanas. Diagnóstico honesto, repuestos originales y garantía por escrito.
            </p>
            <div class="mt-7 flex flex-wrap items-center gap-3.5">
              <Button href="#contacto" variant="dark">Solicitar diagnóstico</Button>
              <span class="inline-flex items-center gap-2 text-[13px] font-semibold text-navy/60">
                <svg
                  class="h-4 w-4 animate-bounce"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"></path>
                </svg>
                Desliza para descubrir más
              </span>
            </div>
          </div>
        </Container>
      </div>
    </div>

    {/* ── CAPA 2: Hero original (aparece con el scroll) ── */}
    <div
      id="main-hero"
      class="absolute inset-0 z-[1] opacity-0 will-change-[opacity,transform]"
      aria-hidden="true"
    >
      <section class="relative flex h-full overflow-hidden overflow-y-auto bg-navy text-white">
        {/* Imagen de fondo */}
        <img
          id="main-hero-bg"
          src="/hero.jpg"
          alt=""
          aria-hidden="true"
          class="absolute inset-0 h-full w-full object-cover will-change-transform"
          loading="eager"
        />

        {/* Overlay para legibilidad del texto */}
        <div
          class="absolute inset-0 bg-gradient-to-r from-navy/95 via-navy/80 to-navy/30 max-[900px]:bg-gradient-to-b max-[900px]:from-navy/90 max-[900px]:via-navy/75 max-[900px]:to-navy/40"
          aria-hidden="true"
        >
        </div>

        <Container
          class="relative z-[3] m-auto grid w-full grid-cols-[1.05fr_0.85fr] items-center gap-10 py-10 max-[900px]:grid-cols-1 max-[900px]:gap-8 max-sm:px-10"
        >
          <div id="main-hero-content" class="will-change-[opacity,transform]">
            <p
              class="mb-[22px] flex items-center gap-2.5 text-[13.5px] font-semibold tracking-[0.01em] text-teal-light"
            >
              <span
                class="h-[7px] w-[7px] rounded-full bg-teal-light shadow-[0_0_0_3px_rgba(95,212,196,0.18)] animate-pulse-dot"
              ></span>
              Técnicos certificados · Las Condes y Región Metropolitana
            </p>

            <h2
              class="max-w-[620px] font-display text-[clamp(34px,5.6vw,60px)] leading-[1.08] font-bold"
            >
              Su equipo de frío,<br /><span class="text-teal-light">funcionando</span> como el primer día.
            </h2>

            <p class="mt-[22px] max-w-[480px] text-base leading-[1.7] text-[#c6d3d2]">
              Reparamos refrigeradores, aire acondicionado y cámaras de frío — en todas sus
              marcas. Diagnóstico honesto, repuestos originales y garantía por escrito.
            </p>

            <div class="mt-8 flex flex-wrap gap-3.5">
              <Button href="#contacto" variant="primary">Solicitar diagnóstico</Button>
              <Button href="#servicios" variant="outline">Ver servicios</Button>
            </div>

            <div class="mt-12 flex flex-wrap gap-[30px]">
              {stats.map((stat) => <HeroStat {...stat} />)}
            </div>
          </div>

          {/* Panel de servicios "en línea" */}
          <aside
            class="relative z-[3] -rotate-[1.4deg] rounded-[10px] bg-paper-2 px-[26px] pt-[26px] pb-[22px] text-ink shadow-[0_30px_60px_-20px_rgba(0,0,0,0.55)] max-[900px]:rotate-0 max-sm:p-5"
            aria-label="Panel de servicios en línea"
          >
            <div class="flex items-center gap-3">
              <Logo tone="teal-deep" class="h-[46px] w-[46px]" />
              <div>
                <p class="font-display text-[19px] leading-[1.15] font-bold text-navy">{site.name}</p>
                <p class="mt-1.5 text-[10.5px] font-semibold tracking-[0.03em] text-brick">
                  PANEL DE SERVICIOS · EN LÍNEA
                </p>
              </div>
            </div>

            <div class="my-4 h-0.5 bg-gradient-to-r from-teal to-transparent" aria-hidden="true"></div>

            <div class="flex flex-col gap-[9px]">
              {statusLines.map((line) => <ServiceStatusRow label={line} />)}
            </div>

            <div
              class="mt-[18px] flex flex-wrap items-center justify-between gap-1.5 border-t border-dashed border-line pt-3.5"
            >
              <span class="text-[10.5px] font-semibold tracking-[0.02em] text-ink-soft"
                >Disponibilidad</span
              >
              <span class="text-[10.5px] font-semibold tracking-[0.02em] text-teal-deep">
                {site.hoursShort}
              </span>
            </div>
          </aside>
        </Container>
      </section>
    </div>
  </div>
</div>

<noscript>
  <style>
    #hero-scroll {
      height: auto !important;
    }
    #hero-sticky {
      position: relative !important;
      top: 0 !important;
      height: auto !important;
    }
    #first-view,
    #main-hero {
      position: relative !important;
      opacity: 1 !important;
      transform: none !important;
      visibility: visible !important;
    }
  </style>
</noscript>

<script>
  (() => {
    const scrollWrap = document.getElementById('hero-scroll');
    const sticky = document.getElementById('hero-sticky');
    const firstView = document.getElementById('first-view');
    const introBg = document.getElementById('intro-bg');
    const introText = document.getElementById('intro-text');
    const mainHero = document.getElementById('main-hero');
    const mainContent = document.getElementById('main-hero-content');
    const mainBg = document.getElementById('main-hero-bg');
    if (!scrollWrap || !sticky || !firstView || !mainHero) return;

    // Movimiento reducido: mostrar ambas secciones apiladas, sin transición por scroll.
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (reduceMotion.matches) {
      scrollWrap.style.height = 'auto';
      sticky.style.position = 'relative';
      sticky.style.top = '0';
      sticky.style.height = 'auto';
      firstView.style.position = 'relative';
      mainHero.style.position = 'relative';
      mainHero.style.opacity = '1';
      mainHero.style.visibility = 'visible';
      mainHero.removeAttribute('aria-hidden');
      return;
    }

    const clamp01 = (v) => Math.min(1, Math.max(0, v));
    let ticking = false;

    function update() {
      ticking = false;
      const total = scrollWrap.offsetHeight - sticky.offsetHeight;
      if (total <= 0) return;
      const progress = clamp01(window.scrollY / total);

      // La intro se va en el primer 70% del recorrido.
      const out = clamp01(progress / 0.7);
      // El hero entra desde el 25% y está completo al 85%.
      const inn = clamp01((progress - 0.25) / 0.6);

      const easeOut = 1 - Math.pow(1 - out, 2);
      const easeIn = inn * inn * (3 - 2 * inn);

      firstView.style.opacity = String(1 - easeOut);
      firstView.style.visibility = out >= 0.99 ? 'hidden' : 'visible';
      firstView.style.pointerEvents = out > 0.5 ? 'none' : 'auto';

      if (introBg) {
        introBg.style.transform = `scale(${1 + 0.06 * easeOut})`;
      }
      if (introText) {
        introText.style.opacity = String(1 - easeOut);
        introText.style.transform = `translate3d(${40 * easeOut}px, ${-12 * easeOut}px, 0)`;
      }

      mainHero.style.opacity = String(easeIn);
      mainHero.style.visibility = easeIn <= 0.01 ? 'hidden' : 'visible';
      mainHero.style.pointerEvents = easeIn > 0.5 ? 'auto' : 'none';
      if (easeIn > 0.01) {
        mainHero.removeAttribute('aria-hidden');
      } else {
        mainHero.setAttribute('aria-hidden', 'true');
      }

      if (mainContent) {
        mainContent.style.opacity = String(easeIn);
        mainContent.style.transform = `translate3d(0, ${(1 - easeIn) * 70}px, 0)`;
      }
      if (mainBg) {
        mainBg.style.transform = `scale(${1.12 - 0.12 * easeIn})`;
      }
    }

    function requestUpdate() {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }

    update();
    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestUpdate);
  })();
</script>
