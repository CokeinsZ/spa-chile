---
import Button from '../atoms/Button.astro';
import Container from '../atoms/Container.astro';
import Logo from '../atoms/Logo.astro';
import HeroStat from '../molecules/HeroStat.astro';
import ServiceStatusRow from '../molecules/ServiceStatusRow.astro';
import { site } from '../../data/site';

const stats = [
  { value: '40+', label: 'Años en el oficio' },
  { value: '24h', label: 'Respuesta promedio' },
  { value: '100%', label: 'Marcas atendidas' },
];

const statusLines = [
  'Refrigeración domestica y comercial — todas las marcas',
  'Aire acondicionado',
  'Cámaras de frío',
  'Lavadoras y secadoras',
];
---

<section class="relative overflow-hidden bg-navy pt-16 text-white">
  {/* Imagen de fondo */}
  <img
    src="/hero.jpg"
    alt=""
    aria-hidden="true"
    class="absolute inset-0 z-0 h-full w-full object-cover"
    fetchpriority="high"
  />

  {/* Overlay para legibilidad del texto */}
  <div
    class="absolute inset-0 z-[1] bg-gradient-to-r from-navy/95 via-navy/80 to-navy/30 max-[900px]:bg-gradient-to-b max-[900px]:from-navy/90 max-[900px]:via-navy/75 max-[900px]:to-navy/40"
    aria-hidden="true"
  >
  </div>

  <Container
    class="relative z-[3] grid grid-cols-[1.05fr_0.85fr] items-center gap-10 pt-16 pb-24 max-[900px]:grid-cols-1 max-[900px]:gap-8 max-[900px]:pt-10 max-[900px]:pb-14 max-sm:px-10"
  >
    <div>
      <p class="mb-[22px] flex items-center gap-2.5 text-[13.5px] font-semibold tracking-[0.01em] text-teal-light">
        <span
          class="h-[7px] w-[7px] rounded-full bg-teal-light shadow-[0_0_0_3px_rgba(95,212,196,0.18)] animate-pulse-dot"
        ></span>
        Técnicos certificados · Las Condes y Región Metropolitana
      </p>

      <h1 class="max-w-[620px] font-display text-[clamp(34px,5.6vw,60px)] leading-[1.08] font-bold">
        Su equipo de frío,<br /><span class="text-teal-light">funcionando</span> como el primer día.
      </h1>

      <p class="mt-[22px] max-w-[480px] text-base leading-[1.7] text-[#c6d3d2]">
        Reparamos refrigeradores, aire acondicionado y cámaras de frío — en todas sus
        marcas. Diagnóstico honesto, repuestos originales y garantía por escrito.
      </p>

      <div class="mt-8 flex flex-wrap gap-3.5">
        <Button href="#contacto" variant="primary">Solicitar diagnóstico</Button>
        <Button href="#servicios" variant="outline">Ver servicios</Button>
      </div>

      <div class="mt-12 flex flex-wrap gap-[30px]">
        {stats.map((stat) => <HeroStat {...stat} />)}
      </div>
    </div>

    {/* Panel de servicios "en línea" */}
    <aside
      class="relative z-[3] -rotate-[1.4deg] rounded-[10px] bg-paper-2 px-[26px] pt-[26px] pb-[22px] text-ink shadow-[0_30px_60px_-20px_rgba(0,0,0,0.55)] max-[900px]:rotate-0 max-sm:p-5"
      aria-label="Panel de servicios en línea"
    >
      <div class="flex items-center gap-3">
        <Logo tone="teal-deep" class="h-[46px] w-[46px]" />
        <div>
          <p class="font-display text-[19px] leading-[1.15] font-bold text-navy">{site.name}</p>
          <p class="mt-1.5 text-[10.5px] font-semibold tracking-[0.03em] text-brick">
            PANEL DE SERVICIOS · EN LÍNEA
          </p>
        </div>
      </div>

      <div class="my-4 h-0.5 bg-gradient-to-r from-teal to-transparent" aria-hidden="true"></div>

      <div class="flex flex-col gap-[9px]">
        {statusLines.map((line) => <ServiceStatusRow label={line} />)}
      </div>

      <div
        class="mt-[18px] flex flex-wrap items-center justify-between gap-1.5 border-t border-dashed border-line pt-3.5"
      >
        <span class="text-[10.5px] font-semibold tracking-[0.02em] text-ink-soft">Disponibilidad</span>
        <span class="text-[10.5px] font-semibold tracking-[0.02em] text-teal-deep">
          {site.hoursShort}
        </span>
      </div>
    </aside>
  </Container>
</section>
