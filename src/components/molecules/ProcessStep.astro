---
import type { ProcessStep } from '../../data/process';

type Props = ProcessStep;

const { number, title, description } = Astro.props;
---

<div class="bg-paper-2 px-6 py-[30px]">
  <span class="text-[13px] font-bold tracking-[0.02em] text-brick">{number}</span>
  <h3 class="mt-3.5 mb-2.5 font-display text-[17px] font-semibold text-navy">{title}</h3>
  <p class="text-sm leading-[1.6] text-ink-soft">{description}</p>
</div>
