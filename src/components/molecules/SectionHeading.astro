---
import Eyebrow from '../atoms/Eyebrow.astro';

interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  class?: string;
}

const { eyebrow, title, description, class: className } = Astro.props;
---

<div class:list={['mb-12 max-w-[640px]', className]}>
  <Eyebrow>{eyebrow}</Eyebrow>
  <h2 class="font-display text-[clamp(26px,3.6vw,40px)] leading-[1.15] font-bold text-navy">
    {title}
  </h2>
  {description && <p class="mt-3.5 max-w-[520px] text-[15.5px] leading-[1.65] text-ink-soft">{description}</p>}
</div>
